# SubBoost Docker / 私有 NAS 环境变量示例
# 复制为 .env 后按需修改：cp local/local.env.example .env

# 监听地址与宿主机端口（NAS 局域网访问默认使用 0.0.0.0；仅本机反代可改为 127.0.0.1）
SUBBOOST_BIND_ADDRESS=0.0.0.0
SUBBOOST_PORT=3001

# 数据持久化目录（包含自动初始化的 subboost.toml 与 subboost.sqlite3 数据库，直接备份此目录即可）
SUBBOOST_DATA_DIR=./data

# NAS 容器文件权限与时区（可通过 id 命令查看宿主机 UID/GID，群晖常见为 1026:100，飞牛/Linux 常见为 1000:1000）
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# 外部访问地址（可选）：
# 保持默认 http://127.0.0.1:3001 时，SubBoost 会自动根据当前浏览器的访问入口（局域网 IP / Tailscale / 反向代理域名）生成对应的订阅链接与二维码。
# 如需在任何入口下都强制生成固定公网域名的订阅链接，可取消注释并填写：
# APP_URL=https://sub.example.com

# 首次初始化管理员账号的令牌（可选，日常免登录游客工作空间无需设置）：
# openssl rand -hex 24
LOCAL_SETUP_TOKEN=
