SUBBOOST_IMAGE=ghcr.io/subboost/subboost:latest
SUBBOOST_BACKEND_IMAGE=ghcr.io/subboost/subboost-backend:latest
APP_URL=http://127.0.0.1:3001
SUBBOOST_PORT=3001
SUBBOOST_BIND_ADDRESS=127.0.0.1
# Optional administrator initialization; guests need no account or token.
LOCAL_SETUP_TOKEN=
# /data contains SQLite, any WAL files, and its adjacent encryption key.
# Back up the entire volume only while the backend is stopped: subboost backup.
